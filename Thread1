import java.awt.*;
import java.awt.event.*;
import javax.swing.*;

class Frame implements ActionListener{
    JLabel lb1,lb2,lb;
    JTextField fd1,fd2;
    JButton btn;
    Frame(){
        JFrame frm=new JFrame("Admission Count");
        frm.setSize(1000,100);
        frm.setLayout(new GridLayout(4,2));
        frm.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        lb1=new JLabel("CSE Count: ");
        fd1=new JTextField(5);
        lb2=new JLabel("CSBS Count: ");
        fd2=new JTextField(5);
        btn=new JButton("Submit");
        btn.addActionListener(this);
        lb=new JLabel("");
        frm.add(fd1);
        frm.add(fd2);
        frm.add(lb1);
        frm.add(lb2);
        frm.add(btn);
        frm.add(new JLabel());
        frm.add(lb);
        frm.setVisible(true);
    }
    public void actionPerformed(ActionEvent ae){
        int cseCount=0;
        int csbsCount=0;
        Boolean invalidFlag=false;
        try{
            cseCount=Integer.parseInt(fd1.getText());
            csbsCount=Integer.parseInt(fd2.getText());
        }catch(NumberFormatException e){
            invalidFlag=true;
        }

    }
}
public class Threading{
    public static void main(String[] args) {
        new Frame();
    }
}
